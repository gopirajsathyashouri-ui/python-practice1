import json
import os

import pandas as pd
import requests

url = "https://disease.sh/v3/covid-19/countries"

os.makedirs(
    "data/raw",
    exist_ok=True
)

response = requests.get(url, timeout=30)
response.raise_for_status()

data = response.json()

with open(
    "data/raw/covid_raw.json",
    "w",
    encoding="utf-8"
) as file:
    json.dump(data, file, indent=2)

df = pd.DataFrame(data)

print(df.head())
print(df.columns)